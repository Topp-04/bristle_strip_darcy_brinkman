FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}

// Darcy-Brinkman strip:  K = 1.005000e-04 m^2,  Da = K/D^2 = 1.005000e+00
stripDarcy
{
    type            semiImplicitSource;
    selectionMode   cellZone;      // OpenFOAM <= 11 keyword
    select          cellZone;      // newer keyword (unused entries are ignored)
    cellZone        strip;
    volumeMode      specific;
    sources
    {
        U
        {
            explicit    (0 0 0);
            implicit    -6.31094527e+00;   // -nu/K [1/s]
        }
    }
}
